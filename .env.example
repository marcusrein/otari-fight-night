# Copied to .env by `make fight` on first run, with fresh keys filled in.
# Edit .env, not this file. Models are chosen in team.yml, not here.

# Otari admin key: signs you into the dashboard at http://localhost:8000
OTARI_MASTER_KEY=__GENERATED__

# One scoped Otari key per team, so usage splits between the stock team and yours.
TEAM_KEY=__GENERATED__
STOCK_KEY=__GENERATED__

# Optional. An otari.ai API key makes `otari-ai:<vendor>/<model>` usable in team.yml
# (hosted frontier models through the same gateway). Requests on it cost money and
# the fight card marks those rows as not processed locally.
OTARI_AI_KEY=

# Where the referee finds things. Defaults work for docker compose + host Ollama.
OTARI_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434

# The fight. ROWS=20 for a quick run. SEED fixes the messy file so a fight can be replayed.
# PRESET is easy, medium or brutal. TEAM and STOCK point at team files.
ROWS=50
PRESET=medium
SEED=
TEAM=team.yml
STOCK=teams/stock.yml
TIMEOUT_SECONDS=120
