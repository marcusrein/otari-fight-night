# Copied to .env by `make fight` on first run, with fresh keys filled in.
# Edit .env, not this file.

# The two fighters. Any model Ollama can pull. Pick two that fit in RAM together.
# 16 GB: the defaults below. 8 GB: llama3.2:3b and qwen2.5:3b.
FIGHTER_A=llama3.1:8b
FIGHTER_B=qwen2.5:7b

# Otari admin key: signs you into the dashboard at http://localhost:8000
OTARI_MASTER_KEY=__GENERATED__

# One scoped Otari key per fighter, so the dashboard and fight card split usage per model.
FIGHTER_A_KEY=__GENERATED__
FIGHTER_B_KEY=__GENERATED__

# Where the referee finds things. Defaults work for docker compose + host Ollama.
OTARI_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434

# Fight settings. ROUNDS=2 for a quick smoke run. SEED fixes the secret codes so a fight can be replayed.
ROUNDS=20
SEED=
MAX_GUESSES=10
TIMEOUT_SECONDS=60
MAX_TOKENS=300

# Twist the game: code length and highest digit (defaults are the classic 4 digits from 1-6).
CODE_LENGTH=4
MAX_DIGIT=6
